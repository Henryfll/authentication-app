# Configuración de despliegue para compose.prod.yaml.
# Copiar a `.env` (que está en .gitignore) y completar. NUNCA subir `.env` al repositorio.

# --- Imagen -----------------------------------------------------------------------------------
# Etiqueta de la imagen a ejecutar (compilar con: docker build -t authentication-app:latest .)
IMAGE=authentication-app:latest
# Puerto del host en el que se publica la API. Poner TLS delante (ver docs/DEPLOYMENT.md).
HTTP_PORT=8080

# --- Base de datos ----------------------------------------------------------------------------
POSTGRES_PASSWORD=cambiar-por-una-contraseña-larga-y-aleatoria

# --- Tokens -----------------------------------------------------------------------------------
# URL pública del servicio: va en el claim `iss` y la validan las aplicaciones que usan los tokens.
JWT_ISSUER=https://auth.example.com
# Identificador de la clave de firma (kid). Cambiarlo al rotar la clave.
JWT_KEY_ID=auth-key-2026-01
# Clave privada RSA (>= 2048 bits) en PEM PKCS#8, en UNA línea con los saltos como \n.
# Generarla con:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:3072 -out jwt-private.pem
#   awk 'NF {printf "%s\\n", $0}' jwt-private.pem
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Primer administrador (opcional; solo hace falta en el primer arranque) -------------------------
AUTH_BOOTSTRAP_ADMIN_EMAIL=
AUTH_BOOTSTRAP_ADMIN_PASSWORD=

# --- Opcionales -------------------------------------------------------------------------------
# Exponer Swagger UI y /v3/api-docs (desactivado por defecto en producción).
OPENAPI_ENABLED=false
# Tamaño del pool de conexiones a la base de datos.
DB_POOL_SIZE=10
